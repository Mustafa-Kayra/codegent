{
  "name": "ai-agent",
  "displayName": "AI Agent",
  "description": "GitHub Copilot alternatifi - AI destekli kod tamamlama ve sohbet",
  "version": "0.1.0",
  "publisher": "codegent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "copilot",
    "code completion",
    "chat",
    "assistant",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "aiAgent.openChat",
        "title": "AI Agent: Sohbet Panelini Aç",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiAgent.explainCode",
        "title": "AI Agent: Seçili Kodu Açıkla"
      },
      {
        "command": "aiAgent.refactorCode",
        "title": "AI Agent: Seçili Kodu Refactor Et"
      },
      {
        "command": "aiAgent.fixCode",
        "title": "AI Agent: Seçili Koddaki Hataları Düzelt"
      },
      {
        "command": "aiAgent.generateTests",
        "title": "AI Agent: Test Oluştur"
      },
      {
        "command": "aiAgent.addDocumentation",
        "title": "AI Agent: Dokümantasyon Ekle"
      },
      {
        "command": "aiAgent.toggleInlineCompletion",
        "title": "AI Agent: Inline Tamamlamayı Aç/Kapat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiAgent",
          "title": "AI Agent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "aiAgent": [
        {
          "type": "webview",
          "id": "aiAgent.chatView",
          "name": "Sohbet"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "aiAgent.explainCode",
          "when": "editorHasSelection",
          "group": "aiAgent@1"
        },
        {
          "command": "aiAgent.refactorCode",
          "when": "editorHasSelection",
          "group": "aiAgent@2"
        },
        {
          "command": "aiAgent.fixCode",
          "when": "editorHasSelection",
          "group": "aiAgent@3"
        },
        {
          "command": "aiAgent.generateTests",
          "when": "editorHasSelection",
          "group": "aiAgent@4"
        },
        {
          "command": "aiAgent.addDocumentation",
          "when": "editorHasSelection",
          "group": "aiAgent@5"
        }
      ]
    },
    "configuration": {
      "title": "AI Agent",
      "properties": {
        "aiAgent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "AI Agent'ı etkinleştir/devre dışı bırak"
        },
        "aiAgent.inlineCompletionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Inline kod tamamlamayı etkinleştir (Tab ile)"
        },
        "aiAgent.model": {
          "type": "string",
          "default": "claude-sonnet-4",
          "enum": [
            "claude-sonnet-4",
            "gpt-4o",
            "gemini-3-pro-preview",
            "openrouter:anthropic/claude-3.7-sonnet",
            "openrouter:openai/gpt-5",
            "openrouter:google/gemini-2.5-pro",
            "openrouter:deepseek/deepseek-r1"
          ],
          "description": "Kullanılacak AI modeli"
        },
        "aiAgent.language": {
          "type": "string",
          "default": "tr",
          "enum": [
            "tr",
            "en",
            "zh",
            "es",
            "de",
            "fr",
            "ja",
            "ko",
            "pt",
            "ru"
          ],
          "description": "Yanıt dili"
        },
        "aiAgent.maxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Maksimum yanıt token sayısı"
        },
        "aiAgent.completionDelay": {
          "type": "number",
          "default": 500,
          "description": "Inline tamamlama gecikmesi (ms)"
        },
        "aiAgent.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP sunucu yapılandırmaları",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Sunucu adı"
              },
              "command": {
                "type": "string",
                "description": "Çalıştırma komutu"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Komut argümanları"
              },
              "env": {
                "type": "object",
                "description": "Ortam değişkenleri"
              }
            }
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "aiAgent.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "aiAgent.toggleInlineCompletion",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mustafa-Kayra/codegent"
  },
  "bugs": {
    "url": "https://github.com/Mustafa-Kayra/codegent/issues"
  },
  "homepage": "https://github.com/Mustafa-Kayra/codegent#readme"
}
